<Window x:Class="Pharmacy.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аптека — учёт лекарственных средств" Height="560" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Учет лекарственных средств" FontSize="24" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,10">
            <TextBox x:Name="SearchBox" Width="360" Height="30" VerticalContentAlignment="Center" />
            <Button Content="Поиск" Width="90" Height="30" Margin="10,0,0,0" Click="Search_Click" />
            <Button Content="Сбросить" Width="90" Height="30" Margin="10,0,0,0" Click="Reset_Click" />
        </StackPanel>

        <DataGrid x:Name="MedicinesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" Margin="0,5,0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="180" />
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="100" />
                <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="90" />
                <DataGridTextColumn Header="Срок годности" Binding="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}" Width="130" />
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="75" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Добавить" Width="100" Height="30" Click="Add_Click" />
            <Button Content="Изменить" Width="100" Height="30" Margin="10,0,0,0" Click="Edit_Click" />
            <Button Content="Продать" Width="100" Height="30" Margin="10,0,0,0" Click="Sell_Click" />
            <TextBlock x:Name="StatusText" Margin="20,5,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
